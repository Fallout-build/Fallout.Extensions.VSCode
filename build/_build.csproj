<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UseArtifactsOutput>false</UseArtifactsOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
    <!-- Versioning tool, resolved out of the package folder by [NuGetTool]. Downloaded rather
         than referenced: it is a CLI the build shells out to, not a library it compiles against. -->
    <PackageDownload Include="nbgv" Version="[3.10.91]" />
  </ItemGroup>

  <ItemGroup>
    <!-- The vsce/ovsx toolchain, as a Fallout plugin. ProjectReference while the surface
         settles; swap for a PackageReference once it is published to a feed. -->
    <ProjectReference Include="../plugins/Fallout.Vsce/Fallout.Vsce.csproj" />
  </ItemGroup>

</Project>
