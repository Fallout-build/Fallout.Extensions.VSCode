<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Cleared so a machine-level feed can't shadow the pinned Fallout packages.
         Fallout 10.4.0 (framework + CLI) ships on nuget.org, so that is the only
         source needed — the private GitHub Packages feed the -preview dogfood
         builds required is gone, along with its token. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
